                                                                                                                {
                                                                                                                    "dsDescriptionValue":  {
                                                                                                                                               "typeName":  "dsDescriptionValue",
                                                                                                                                               "multiple":  false,
                                                                                                                                               "typeClass":  "primitive",
                                                                                                                                               "value":  "This dataset includes data collected during the 2020 agricultural season as part of the Baix Ter case study (CS2). The irrigation strategies tested were similar to those implemented in 2019: wet seeding with continuous flooding (WFL), dry seeding with delayed flooding (DFL), and dry seeding with subsurface drip irrigation (SDI). In 2020, an additional SDI pilot field was introduced at the Benzinera pilot farm, located in Pals within the traditional rice-growing area. In addition, the dataset includes the experimental layouts of the pilot fields and the rice varieties cultivated under each irrigation strategy."
                                                                                                                                           }
                                                                                                                }
                                                                                                            ]
