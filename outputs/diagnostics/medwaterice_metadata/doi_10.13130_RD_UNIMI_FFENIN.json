                                                                                                                {
                                                                                                                    "dsDescriptionValue":  {
                                                                                                                                               "typeName":  "dsDescriptionValue",
                                                                                                                                               "multiple":  false,
                                                                                                                                               "typeClass":  "primitive",
                                                                                                                                               "value":  "This dataset contains data collected during the 2021 agricultural season in the Nile Delta case study (Egypt). Four irrigation strategies were tested: in the Northern Nile Delta, traditional flooding (WFL) and HYBRID, each tested with two water qualities (freshwater and drainage water); and in the Eastern Nile Delta, sprinkler irrigation and surface drip irrigation. For each strategy, three cultivation methods were applied (drill seeding, raised beds, and the System of Rice Intensification (SRI)) in combination with five rice varieties (Giza 177, Giza 178, Sakha Super 300, Hybrid Rice-EH1, and Dry Rice-L1). The dataset also includes the experimental field layouts and detailed information on the cultivated rice varieties."
                                                                                                                                           }
                                                                                                                }
                                                                                                            ]
